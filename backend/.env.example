## Backend service env (local/dev)
## Auth uses Redis-only live sessions (no JWT).
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.redis.io:PORT

## Live session TTL in Redis (default: 10d)
SESSION_TTL=10d
SESSION_COOKIE_SAMESITE=lax

PORT=8000

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hall_db

PAYMENT_SERVER_URL=http://localhost:8080
PAY_SERVICE_SECRET=generate-a-base64-32-byte-secret

# Brevo SMTP Config
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465
BREVO_SMTP_USER=your-smtp-user@smtp-brevo.com
BREVO_SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@yourdomain.com

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_SANDBOX=true
API_PUBLIC_URL=https://your-public-api-url.example.com
STUDENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:4001

NODE_ENV=development
