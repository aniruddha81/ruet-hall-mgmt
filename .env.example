# Single .env for local npm run dev AND production Docker Compose (repo root).
# backend/, web/, and admin/ all load this file. Do not add per-app env files.

# Database (PostgreSQL 18)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hall_db
# Local dev / drizzle — Docker Compose builds DATABASE_URL for the backend container
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hall_db

# Ports
BACKEND_PORT=8000
PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Local Next.js rewrites (web + admin npm run dev). Docker always uses http://backend:8000.
BACKEND_API_URL=http://localhost:8000

# Public URLs (CORS, SSLCommerz, payment redirects)
API_PUBLIC_URL=https://api.yourdomain.com
STUDENT_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Redis Cloud (sessions)
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.redis.io:PORT
SESSION_TTL=10d

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_SANDBOX=true

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465
BREVO_SMTP_USER=your-smtp-user@smtp-brevo.com
BREVO_SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@yourdomain.com

# Next.js (web + admin — keep stable across rebuilds)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate-a-base64-32-byte-key
